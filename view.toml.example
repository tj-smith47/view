# view.toml -- copy to $XDG_CONFIG_HOME/view/view.toml (~/.config/view/view.toml)
#
# Every key is optional. An absent or empty file is the full experience:
# every native feature below is at the value shown beside it.
#
# [native] turns a native feature off and hands that surface back to your
# own plugins. Turning one off is reversible and touches nothing else: view
# never edits your config, and your plugins keep loading either way.
#
# tree_width and tabline_shows are the two keys here that are not switches:
# the share of the terminal width the file tree opens at, and what the top
# pill names. The resize keys under [keys] step
# the focused tree by 5% for the session; this is where a width that should
# outlive the session goes.

[native]
picker = true
tree = true
statusline = true
notifications = true       # false hands the message area back: ext_messages
                           # is not attached, so nvim draws its own messages
                           # and hit-enter prompts on the last row again, and
                           # vim.notify is left wherever your plugins put it
                           # instead of being held at the engine default
palette = true             # false hands back the command line and its
                           # completion popup: ext_cmdline/ext_popupmenu are
                           # not attached, so `:` is nvim's own last row
# tabline = true           # the one switch with no fixed default: it follows
                           # [ui] panes, on under "tiles" and off under
                           # "nvim", and a value written here wins either way.
                           # On, view draws the top pill: your tabpages or
                           # buffers across the middle, the --remote host at
                           # the left and what the agent is doing at the
                           # right. Off leaves ext_tabline unattached, so your
                           # own tabline (bufferline, or nvim's default tab
                           # labels) draws that row
tabline_shows = "tabs"     # default: tabs -- what the pill names while one
                           # tabpage is open. "buffers" names your open files
                           # instead; a second tabpage is named as tabpages
                           # either way, since a tabpage you made is the thing
                           # the row would otherwise hide
tree_width = 30            # default: 30 -- percent of the terminal width,
                           # clamped to 15..70: any whole number outside that
                           # range opens at the nearest end, and anything that
                           # is not a whole number opens at 30 with a notice.
                           # A width is never a reason view refuses the file

# [keys] rebinds view's own keys: the two that resize whichever sidebar --
# the file tree or the AI panel -- has the keyboard, and the one that breaks
# a line in the agent panel's composer, where <CR> sends the prompt instead.
# Each action takes one key notation or a list of them, spelled the way nvim
# spells keys, and a binding may be a two-key chord. Every default is listed
# below: a shifted arrow, and nvim's own window-resize chord for the
# terminals that swallow the arrows before view sees them (macOS Terminal,
# Termius); an alted and a shifted Enter for the composer, of which <M-CR>
# works everywhere and <S-CR> wherever the terminal speaks the kitty
# keyboard protocol -- a shifted Enter is distinguishable from a plain one
# only under that protocol. What decides it is the startup capability
# probe's answer, not the tier: every full-tier terminal answers the kitty
# keyboard query, and a terminal that answers it while sitting below full
# for an unrelated reason (truecolor still unresolved over ssh, say) gets
# <S-CR> too. See docs/keymaps.md for which exits pop the protocol.
#
# Names are case-sensitive: <S-Right>, not <S-right>. A notation that
# cannot be a key -- an unknown modifier prefix, or a name that is neither
# one character nor one of nvim's own (Left, CR, Esc, Tab, BS, Space, lt,
# F1...) -- is reported, as is a value view cannot read as keys at all.
# Either leaves that one action on its defaults, and neither is ever a
# reason view refuses the file. A well-formed name this build never
# receives is still simply inert. Alt is written M-, the way view's own
# encoder emits it; A- is read as the same modifier.

[keys]
sidebar_wider = ["<S-Right>", "<C-w>>"]
sidebar_narrower = ["<S-Left>", "<C-w><"]
composer_newline = ["<S-CR>", "<M-CR>"]
toggle_gaps = "<F9>"
cycle_surfaces = "<F10>"

# [supervision] decides how far view goes on its own when the engine fails.
# Detection is always on: a wedged or dead engine raises a notice and, past
# a short grace period, an interrupt/restart modal. This switch is only
# about the automatic half, and only about an engine that died: one that
# exited because you told it to (`:q`, `:cq`) is the session ending, and
# view leaves with nvim's own status no matter how this is set.
#
# view tells those two apart by nvim announcing its own departure as it
# leaves, not by the status it exits with -- so a quit is a quit on Linux,
# macOS and Windows alike, and an engine that dies without a word is a
# death even when it manages to exit 0.

[supervision]
auto_restart = true        # false: surface a dead engine and wait for the modal's own Restart

# [engine] names the editor view runs and the profile it runs under, and
# both are derived when the key is absent. A release ships a pinned nvim
# beside the view binary and runs that one; a build with none beside it
# falls back to the nvim on your PATH. Naming an absolute path here runs
# that editor instead.
#
# Both keys are also flags for a single session -- view --nvim-bin PATH and
# view --appname NAME -- and a flag outranks this file, as does the matching
# VIEW_ENGINE_* variable. A path that cannot be spawned is reported naming
# the path and the layer that named it, so a failure is traceable to the
# thing that caused it.

[engine]
nvim_bin = "bundled"       # default: "bundled" -- the pinned engine beside
                           # this binary, or the nvim on PATH in a build
                           # that ships none. An absolute path runs that
                           # editor instead
# appname = "work"         # default: whatever NVIM_APPNAME already names,
                           # and nvim's own profile when nothing does. Set
                           # it for an isolated config and state directory;
                           # view never requires one. There is no value here
                           # that means inherit -- leaving the key out is
                           # how you say it, which is why this line ships
                           # commented rather than empty
single_grid = false        # default: false -- view composites nvim's windows
                           # itself. Set true (or pass --single-grid) to let
                           # nvim draw one grid, which is the fallback when a
                           # plugin misbehaves under the multigrid protocol.
                           # See docs/multigrid.md.

# [ui] is what view paints with: how much of the terminal's own capability
# it uses, which colorscheme the session runs, how windows are drawn, and
# the colours you name for yourself. Every key derives when it is absent,
# and "auto" is that same absence written down.
#
# tier is the summary of the startup capability probe -- synchronized
# output, truecolor, the kitty keyboard protocol -- and naming one here
# forces it for terminals the probe reads wrong (a multiplexer that answers
# for itself rather than for the terminal behind it). `view --print-caps`
# prints the capabilities and where they came from, so a forced tier is a
# last resort rather than a first guess.
#
# theme names a colorscheme for nvim to run. view holds no palette of its
# own: nvim applies the scheme with its own :colorscheme and view derives
# its chrome from the highlight table nvim then reports, which is why any
# name your plugins can load works here and why "auto" -- deriving from
# whatever colorscheme your own config ends on -- costs nothing extra. A
# name nvim cannot find is reported and the derived chrome stands.
#
# panes decides how your windows are drawn. "tiles" gives every window a
# frame of view's own, with the one you are working in picked out in the
# accent colour, and each tile says its own buffer name, branch, diagnostic
# counts and cursor position in its frame; "nvim" leaves the picture nvim
# paints for itself and keeps view's status bar on the bottom row. "auto"
# reads your session: a
# tiling window manager is already arranging your screen, so view stays out
# of its way and draws "nvim" there, and everything else -- a desktop, a
# terminal on macOS or Windows, an ssh session -- gets "tiles". :View ui
# panes tiles switches a running session, and :View ui panes on its own says
# which mode you are in and what decided it.
#
# gaps is about tiles only: true leaves a gap between neighbouring frames,
# false has them share their edges.
#
# [ui.tokens] is where you name a colour yourself instead of letting view
# derive it. accent is the colour on the active tile's frame; left out, view
# takes it from your colorscheme.
#
# tier, theme and panes are also flags for a single session -- view --tier
# basic, view --theme gruvbox, view --panes nvim -- and a flag outranks this
# file, as does the matching VIEW_UI_* variable.

[ui]
tier = "auto"              # default: "auto" -- the probed terminal
                           # capability set. full | standard | basic force a
                           # tier when a probe is wrong; `view
                           # --print-caps` prints what was probed
theme = "auto"             # default: "auto" -- view derives its chrome from
                           # whatever colorscheme your config ends on. A
                           # name runs nvim's own :colorscheme and derives
                           # from that instead
panes = "auto"             # default: "auto" -- tiles everywhere except under
                           # a tiling window manager. tiles | nvim force it
gaps = true                # default: true -- a gap between neighbouring
                           # frames. false has them share their edges

[ui.tokens]
accent = "auto"            # default: "auto" -- the active tile's frame
                           # colour, derived from your colorscheme. A hex
                           # colour such as "#89b4fa" names it yourself

# [ui.surfaces] is where each of view's own surfaces sits. placement
# "overlay" floats it over your buffer; "windowed" gives it a window of its
# own in nvim's layout, so your buffers make room for it and every window
# command reaches it. anchor is the edge it opens at, and size is its share
# of the terminal. [native] tree_width is [ui.surfaces.tree] size under its
# older name; write either one.

[ui.surfaces]

[ui.surfaces.tree]
placement = "overlay"      # default: "overlay" -- a float over your buffer.
                           # "windowed" opens it as a window of its own
anchor = "left"            # default: "left" -- the edge it opens at.
                           # left | right
size = 30                  # default: 30 -- percent of the terminal width,
                           # on the same clamp-never-refuse terms as
                           # [native] tree_width, whose value this shares

# [ai] turns the agent panel and its ACP client on or off, and names which
# agent view speaks to. "claude-code" is the one adapter this build knows
# how to auto-provision on its own; naming another known adapter id or an
# arbitrary command line runs that instead, unprovisioned.

[ai]
enabled = true             # default: true -- opt-out, matching [native]'s
                           # default-on philosophy
agent = "claude-code"      # default: "claude-code" -- the one adapter this
                           # build knows how to auto-provision.
                           # Override with another known adapter id, or an
                           # arbitrary command: agent = ["mycli", "--acp"]
panel_width = 30           # default: 30 -- percent of the terminal width the
                           # panel opens at, on the same clamp-never-refuse
                           # terms as [native] tree_width, and resized for the
                           # session with the same keys, see [keys]. Its own
                           # newer name is [ui.surfaces.agent] size

# [ai.review] is how an agent's proposed change presents itself. The diff is
# drawn in the file's own buffer, so the only choice is where that file goes
# when no window already has it open.

[ai.review]
open_target = "current"    # default: "current" -- the window you are in, the
                           # way the picker and the tree open a file.
                           # "split" leaves what you were reading beside it.
                           # Anything else opens in the current window and
                           # says so.
