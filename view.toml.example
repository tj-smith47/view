# view.toml -- copy to $XDG_CONFIG_HOME/view/view.toml (~/.config/view/view.toml)
#
# Every key is optional. An absent or empty file is the full experience:
# every native feature below is on.
#
# [native] turns a native feature off and hands that surface back to your
# own plugins. Turning one off is reversible and touches nothing else: view
# never edits your config, and your plugins keep loading either way.
#
# tree_width is the one key here that is not a switch: the share of the
# terminal width the file tree opens at. The resize keys under [keys] step
# the focused tree by 5% for the session; this is where a width that should
# outlive the session goes.

[native]
picker = true
tree = true
statusline = true
notifications = true
palette = true
tree_width = 30            # default: 30 -- percent of the terminal width,
                           # clamped to 15..70: any whole number outside that
                           # range opens at the nearest end, and anything that
                           # is not a whole number opens at 30 with a notice.
                           # A width is never a reason view refuses the file

# [keys] rebinds view's own keys: the two that resize whichever sidebar --
# the file tree or the AI panel -- has the keyboard, and the one that breaks
# a line in the agent panel's composer, where <CR> sends the prompt instead.
# Each action takes one key notation or a list of them, spelled the way nvim
# spells keys, and a binding may be a two-key chord. Every default is listed
# below: a shifted arrow, and nvim's own window-resize chord for the
# terminals that swallow the arrows before view sees them (macOS Terminal,
# Termius); a shifted and an alted Enter, because a terminal reports at most
# one of the two.
#
# Names are case-sensitive: <S-Right>, not <S-right>. A notation that
# cannot be a key -- an unknown modifier prefix, or a name that is neither
# one character nor one of nvim's own (Left, CR, Esc, Tab, BS, Space, lt,
# F1...) -- is reported, as is a value view cannot read as keys at all.
# Either leaves that one action on its defaults, and neither is ever a
# reason view refuses the file. A well-formed name this build never
# receives is still simply inert. Alt is written M-, the way view's own
# encoder emits it; A- is read as the same modifier.

[keys]
sidebar_wider = ["<S-Right>", "<C-w>>"]
sidebar_narrower = ["<S-Left>", "<C-w><"]
composer_newline = ["<S-CR>", "<M-CR>"]

# [supervision] decides how far view goes on its own when the engine fails.
# Detection is always on: a wedged or dead engine raises a notice and, past
# a short grace period, an interrupt/restart modal. This switch is only
# about the automatic half, and only about an engine that died: one that
# exited because you told it to (`:q`, `:cq`) is the session ending, and
# view leaves with nvim's own status no matter how this is set.
#
# view tells those two apart by nvim announcing its own departure as it
# leaves, not by the status it exits with -- so a quit is a quit on Linux,
# macOS and Windows alike, and an engine that dies without a word is a
# death even when it manages to exit 0.

[supervision]
auto_restart = true        # false: surface a dead engine and wait for the modal's own Restart

# [ai] turns the agent panel and its ACP client on or off, and names which
# agent view speaks to. "claude-code" is the one adapter this build knows
# how to auto-provision on its own; naming another known adapter id or an
# arbitrary command line runs that instead, unprovisioned.

[ai]
enabled = true             # default: true -- opt-out, matching [native]'s
                           # default-on philosophy
agent = "claude-code"      # default: "claude-code" -- the one adapter this
                           # build knows how to auto-provision.
                           # Override with another known adapter id, or an
                           # arbitrary command: agent = ["mycli", "--acp"]
panel_width = 30           # default: 30 -- percent of the terminal width the
                           # panel opens at, on the same clamp-never-refuse
                           # terms as [native] tree_width, and resized for the
                           # session with the same keys, see [keys]

# [ai.review] is how an agent's proposed change presents itself. The diff is
# drawn in the file's own buffer, so the only choice is where that file goes
# when no window already has it open.

[ai.review]
open_target = "current"    # default: "current" -- the window you are in, the
                           # way the picker and the tree open a file.
                           # "split" leaves what you were reading beside it.
                           # Anything else opens in the current window and
                           # says so.

# The tables below are commented out because THIS BUILD DOES NOT READ THEM
# yet. Uncommenting one is harmless -- view ignores tables it has no loader
# for -- but it will not change anything either. They are listed so the
# shape they will take is no surprise, and each one goes live here in the
# same change that gives it a loader.
#
# [ui]
# tier = "auto"              # auto | full | standard | basic
# theme = "auto"             # auto = derive from nvim colorscheme
#
# [engine]
# nvim_bin = "bundled"       # "bundled" | absolute path
# appname = ""               # NVIM_APPNAME passthrough for isolated profiles
# single_grid = false
