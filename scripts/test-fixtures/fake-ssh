#!/bin/sh
# A stand-in for the OpenSSH client, for tests that must exercise the remote
# spawn path on a host with no reachable sshd and no network egress.
#
# It reproduces the one client behaviour those tests are about, rather than a
# more forgiving version of it: real ssh parses its own connection options
# locally, then joins EVERYTHING trailing the destination with spaces into a
# single string and hands that string to the remote user's shell to re-parse.
# A double that exec'd its trailing arguments directly, preserving them as a
# normal argv, would happily run a caller whose quoting is wrong and a real
# remote host would reject, so the re-parse is reproduced here, never
# bypassed.
#
# What it does not reproduce: authentication, host-key verification,
# ~/.ssh/config resolution, and the network hop itself. The command runs on
# this host, as this user.
set -eu

# The client's own options, stripped the way the real one does. Real ssh
# parses them with getopt(3), so a dash argument is a CLUSTER of flags read
# one character at a time, not one opaque token: the first character in it
# that takes a value consumes the REST of the cluster as that value, and the
# characters before it are no-argument flags in their own right. `-Tfoo` is
# therefore `-T -f -o o`, and a glob matching the whole cluster would accept
# spellings the real client rejects -- the direction a double must never
# take. The two character sets below are the ones the real client's own
# usage line prints, so an option it takes a value for is never read here as
# a flag that does not.
while [ "$#" -gt 0 ]; do
    case "$1" in
        --)
            shift
            break
            ;;
        -?*)
            cluster="${1#-}"
            shift
            while [ -n "$cluster" ]; do
                flag="$(printf '%.1s' "$cluster")"
                cluster="${cluster#?}"
                case "$flag" in
                    [46AaCfGgKkMNnqsTtVvXxYy]) ;;
                    [BbcDEeFIiJLlmOoPpQRSWw])
                        # the value is the rest of the cluster when there is
                        # one, and the next argument otherwise
                        if [ -n "$cluster" ]; then
                            cluster=''
                        elif [ "$#" -lt 1 ]; then
                            echo "fake-ssh: -$flag needs a value" >&2
                            exit 255
                        else
                            shift
                        fi
                        ;;
                    # an unrecognized flag is refused rather than shifted
                    # away. Swallowing it would promote the NEXT argument to
                    # destination and run a shifted command, which is more
                    # permissive than the real client (OpenSSH rejects the
                    # option outright), and a double must never accept what
                    # the real one would reject.
                    *)
                        echo "fake-ssh: unrecognized option -$flag" >&2
                        exit 255
                        ;;
                esac
            done
            ;;
        *)
            break
            ;;
    esac
done

if [ "$#" -lt 1 ]; then
    echo "fake-ssh: no destination argument" >&2
    exit 255
fi
case "$1" in
    -*)
        echo "fake-ssh: $1 is not a hostname" >&2
        exit 255
        ;;
esac
# the destination is parsed by the client and never sent; everything after it
# belongs to the remote side
shift

if [ "$#" -lt 1 ]; then
    echo "fake-ssh: no remote command" >&2
    exit 255
fi

# "$*" joins with the first character of IFS (a space), which is the join the
# real client performs before the remote shell ever sees the request. `exec`
# so the remote command inherits this process's own stdin and stdout: those
# are the pipes the caller opened, and the RPC channel runs over them exactly
# as it would over a real connection.
exec sh -c "$*"
