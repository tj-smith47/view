+// captureLayers reads the cursor and text canvases in one evaluation, so
+// xterm.js cannot render a frame between the two reads and composite an
+// older cursor over newer text.
+func (vhs *VHS) captureLayers() ([]byte, []byte, error) {
+	res, err := vhs.Page.Eval(`(format, quality) => [
+		document.querySelector("canvas.xterm-cursor-layer").toDataURL(format, quality),
+		document.querySelector("canvas.xterm-text-layer").toDataURL(format, quality),
+	]`, "image/png", quality)
+	if err != nil {
+		return nil, nil, fmt.Errorf("error capturing frame: %w", err)
+	}
+	layers := res.Value.Arr()
+	if len(layers) != 2 {
+		return nil, nil, fmt.Errorf("error capturing frame: %d layers", len(layers))
+	}
+	cursor, err := decodeDataURL(layers[0].Str())
+	if err != nil {
+		return nil, nil, err
+	}
+	text, err := decodeDataURL(layers[1].Str())
+	if err != nil {
+		return nil, nil, err
+	}
+	return cursor, text, nil
+}
+
+func decodeDataURL(url string) ([]byte, error) {
+	_, data, ok := strings.Cut(url, ",")
+	if !ok {
+		return nil, errors.New("error capturing frame: not a data URL")
+	}
+	return base64.StdEncoding.DecodeString(data)
+}
